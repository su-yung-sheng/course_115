rules_version = '2';

// =====================================================================
//  Firestore 安全規則 — 專案 suyungsheng-5f948
//  涵蓋：115 學年【上學期 11501】＋【下學期 11502】
//  貼上位置：Firebase Console → Firestore Database → 規則 → 發佈
//  最後更新：2026-07-29
// ---------------------------------------------------------------------
//  ⚠️ 一個 Firebase 專案只有「一份」規則，發佈時整份覆蓋。
//     這份是 _shared/ 的產物，改請改 _shared/firestore.rules 再執行 sync_shared.py。
//
//  ⚠️ 這裡是全系統唯一「刻意保留重複」的地方：
//     兩學期的規則明明長得一樣，仍然分開寫。理由是安全規則寫錯的代價太高，
//     用正規式把 11501/11502 合成一條雖然短，但出事時很難一眼看出哪裡開太大。
//     其他檔案追求「一份程式」，這一份追求「一眼看得懂」。
// ---------------------------------------------------------------------
//  ★ 2026-07-29 改版重點
//    ① 名冊改為跨學期共用一份 /roster（同一批八年級學生）。
//       舊的 {學期}-roster 保留到資料遷移完成，之後可整段刪除。
//    ② 刪掉 {學期}-grades：規則裡有，但全站沒有任何一行程式讀寫它。
//    ③ 闖關紀錄（quiz_records）改存進 {學期}-progress 的 history。
//       舊集合的規則移到「待淘汰」區，舊版頁面下線後刪除。
//    ④ 學期鎖：{學期}-progress 的學生寫入限制在該學期期間（用 request.time）。
//       老師不受限；測試帳號見 isTestAccount()。
//    ⑤ 2026-07-30：加入學校 Google 帳號路徑 isOwner(sid)。
//       email 由學號直接組出（qfm{學號}@mail.qfm.kh.edu.tw），不需要對照表，
//       真正做到「只有本人能寫自己的進度」——這是匿名登入時期做不到的。
//       目前與舊的匿名路徑並存，兩條都能寫；全面切換後刪掉匿名那條。
//       老師身分改用 email 白名單（師生都是 google.com，分不出 provider）。
//    ⑥ 2026-08-03：{學期}-progress 多了 modules.list（前導教材通過紀錄）。
//       ★ 這一份規則不做欄位白名單，只看 totalStars 的增減，
//         所以新增欄位不必改規則——這裡記一筆是避免日後有人以為漏改了。
//         學生端用 merge 寫入，totalStars 不動，starsNotReduced 自然成立。
//    ⑦ 2026-08-03：驗證碼備援加上總開關 config/auth。
//       全站已改用學校 Google 帳號，驗證碼只留備援。
//       開關關掉時，舊的匿名寫入路徑、驗證碼設定、登入試探全部失效。
//       ★ 這個開關必須做在規則裡才有意義：只把前端欄位藏起來的話，
//         匿名路徑還在，任何登入者照樣寫得動別人的進度。
// ---------------------------------------------------------------------
//  身分判斷方式：
//    老師 = email/密碼登入（教師端）或學校 Google 帳號（白名單）
//    學生 = 學校 Google 帳號 qfm{學號}@mail.qfm.kh.edu.tw
//           （舊的匿名登入＋驗證碼只在 config/auth 開關打開時有效）
//
//  ⚠️ 已知限制：只要 legacyAllowed() 是開的，那條匿名路徑就認不出本人，
//     仍防不住學生寫別人的成績文件（只能靠「動作幅度」防呆）。
//     關掉開關之後才真正只剩 isOwner()，也就是「只有本人能寫自己的」。
//     其餘一直有效的防線：
//       1. 整批撈走全班姓名與驗證碼（名冊）→ list 只給老師
//       2. 整批撈走或刪除全班成績 → list/delete 只給老師
//       3. 學生覆蓋他人已設定的驗證碼 → secret 只能 create 一次
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= 共用判斷 =================
    function isSignedIn() {
      return request.auth != null;
    }
    /* ===== 學校 Google 帳號 =====
       學生：qfm{7 位學號}@mail.qfm.kh.edu.tw
       老師：suyungsheng@mail.qfm.kh.edu.tw（固定，不會更換）

       ⚠️ 師生都用 Google 登入之後，sign_in_provider 都是 'google.com'，
          沒辦法再靠登入方式分辨身分，所以老師改用 email 白名單。 */
    function TEACHER_EMAIL() { return 'suyungsheng@mail.qfm.kh.edu.tw'; }
    function DOMAIN()        { return '@mail.qfm.kh.edu.tw'; }

    function googleVerified() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string;
    }

    /** 老師。過渡期同時接受兩種：
          ① 舊的 email/密碼登入（現有教師端還在用）
          ② 新的學校 Google 帳號
        全面切換到 Google 之後，把 ① 那一行刪掉。 */
    function isTeacher() {
      return request.auth != null
          && (request.auth.token.firebase.sign_in_provider == 'password'
              || (googleVerified() && request.auth.token.email == TEACHER_EMAIL()));
    }

    /** 這個 Google 帳號是不是「學號 sid 本人」。
        email 直接由學號組出來，不需要任何對照表 —— 這是這套帳號格式最大的好處。 */
    function isOwner(sid) {
      return googleVerified()
          && request.auth.token.email == 'qfm' + sid + DOMAIN();
    }

    /** 是不是學校網域的學生帳號（不指定是誰） */
    function isSchoolStudent() {
      return googleVerified()
          && request.auth.token.email.matches('^qfm[0-9]{7}@mail[.]qfm[.]kh[.]edu[.]tw$');
    }
    /* ===== 驗證碼備援的總開關（2026-08-03）=====
       全面改用學校 Google 帳號之後，舊的「匿名登入＋6 位數驗證碼」
       只留作備援。但只要規則裡的匿名路徑還在，
       任何登入者就寫得動別人的進度 —— 前端把欄位藏起來一點用也沒有。

       所以開關做在這裡：老師在教師端切換 config/auth 的 allowLegacy，
       規則跟著讀，關掉時匿名路徑整條失效。

       ★ 文件不存在 → false（往安全的方向失效）。
         所以「還沒建立這份文件」＝驗證碼不能用，不是全開。

       ★ 代價：每次進度寫入多 exists()+get() 兩次文件讀取，會計費。
         以一個學校的量看不出來，但知道一下。

       ★ 逃生路徑：教師端是 email/密碼登入，不依賴 Google。
         就算學校 Google 整個掛掉、全班登不進去，老師仍進得了教師端
         把開關打開。 */
    function AUTH_DOC() {
      return /databases/$(database)/documents/config/auth;
    }
    function legacyAllowed() {
      return exists(AUTH_DOC())
          && get(AUTH_DOC()).data.allowLegacy == true;
    }

    // 名冊上的「是否已設定驗證碼」旗標（驗證碼本體不在名冊裡，見下方 A2）
    function codeNotSet() {
      return !('hasCode' in resource.data) || resource.data.hasCode != true;
    }

    // 登入試探文件的形狀：只能有 code 與 at 兩個欄位
    function loginShapeOk() {
      return request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code is string;
    }

    /* ===== 學期鎖 =====
       學生只能寫「當學期」的進度。這是真正的防線 ——
       request.time 是伺服器時間，改前端、改電腦時鐘都繞不過去。
       （前端 shared/semester.js 的鎖只是先擋下畫面、給提示。）

       界線：2027-02-01 起為下學期。
         ‧ 學年開始前（準備期）算上學期 → 11501 沒有下界
         ‧ 學年結束後仍算下學期       → 11502 沒有上界
       與 shared/semester.js 的 TABLE 一致，改一邊要改另一邊。 */
    function beforeSpring() {
      return request.time < timestamp.date(2027, 2, 1);
    }
    function afterSpring() {
      return request.time >= timestamp.date(2027, 2, 1);
    }

    /* 測試帳號：不受學期鎖限制。
       ⚠️ 這份清單在 shared/semester.js 裡有一份**一模一樣**的複製
          （安全規則沒辦法載入 JS）。改一邊就要改另一邊。 */
    function isTestAccount(sid) {
      return sid in ['1400000'];        // ← 換成你自己的測試學號
    }

    // ===== 進度文件的防呆（學生匿名登入，規則認不出本人，只能限制「動作幅度」）=====
    //   擋不住有心人，但擋得住兩件最容易發生也最難救的事：
    //     ① 把別人的星星清成 0（惡意破壞）
    //     ② 一次把自己改成滿星（灌水）
    //   單次通關最多 3 顆星，這裡放寬到 6，正常上課不會踩到。
    function starsIn(d) {
      return ('totalStars' in d) ? d.totalStars : 0;
    }

    /* ⚠️ 這兩個要先擋 resource == null。
       正式環境 update 一定有既有文件，但「規則遊樂場」可以模擬
       update 一份不存在的文件，那時 resource 是 null，
       讀 resource.data 會直接拋出
         "Property data is undefined on object"
       —— 錯誤訊息完全看不出真正的原因，會誤導人以為規則寫錯。
       文件不存在時視同「沒有舊星數」，用 0 當基準。 */
    function oldStars() {
      return resource == null ? 0 : starsIn(resource.data);
    }
    function starsNotReduced() {
      return starsIn(request.resource.data) >= oldStars();
    }
    function gainIsSmall() {
      return starsIn(request.resource.data) <= oldStars() + 6;
    }
    function firstWriteIsSmall() {
      return starsIn(request.resource.data) <= 6;
    }


    // ###################################################################
    // ##  A. 跨學期共用
    // ###################################################################

    // ---------- A1. 學生名冊（姓名／班級／座號，★不含驗證碼）----------
    //   上下學期是同一批八年級學生，名冊只需要一份。
    //   這裡存的是「人」；成績與進度仍然分學期。
    //   ⚠️ 驗證碼**不放在這裡**，只留一個 hasCode 旗標讓登入頁判斷是否首次登入。
    match /roster/{sid} {
      // 單筆查詢：登入流程需要（讀姓名讓學生確認身分）
      allow get: if isSignedIn();
      // ❌ 禁止整批下載：避免一次撈走全班姓名
      allow list: if isTeacher();

      allow create, delete: if isTeacher();

      // 更新：老師可任意改；
      //      學生只能在「尚未設定驗證碼」時把 hasCode 立起來，其他欄位一律不准動
      allow update: if isTeacher()
                    || (isSignedIn()
                        && codeNotSet()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['hasCode', 'updatedAt']));
    }


    // ---------- A1b. 全站開關（★ 學生「讀得到」）----------
    //   目前只有一份 config/auth：{ allowLegacy: bool }
    //   學生端要讀它才知道登入畫面該不該顯示驗證碼欄位，
    //   規則也讀它決定要不要開放舊的匿名寫入路徑（見 legacyAllowed()）。
    //
    //   ⚠️ 學生讀得到 ＝ 這個集合只能放「公開也無所謂」的設定。
    //      任何密碼、名單、答案都不可以放這裡；
    //      課程設定請放 {學期}-config（那個是老師才讀得到的）。
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }


    // ---------- A2. 驗證碼本體（★ 學生完全讀不到）----------
    //   跟名冊一樣跨學期共用一份：同一批學生，不需要設兩次。
    //
    //   為什麼要獨立一個集合：
    //     驗證碼原本和姓名放在同一份名冊文件裡，而學生讀得到那份文件，
    //     等於把鎖和鑰匙放在同一個抽屜。搬出來之後，學生連讀都讀不到。
    //
    //   學生怎麼驗證？看 A3：規則跑在伺服器端，可以讀學生讀不到的文件。
    match /secret/{sid} {
      allow read: if isTeacher();        // ❌ 學生一律不可讀
      allow list: if isTeacher();

      // 首次設定：create 只在文件不存在時成立，天然只能成功一次
      //   開關關掉時連設定都不給 —— 否則學生設了碼卻登不進去，只會來問老師
      allow create: if legacyAllowed()
                    && isSignedIn()
                    && request.resource.data.keys().hasOnly(['code', 'at'])
                    && request.resource.data.code is string;

      // 改碼與清除只有老師能做（學生忘記了要找老師）
      allow update, delete: if isTeacher();
    }

    // ---------- A3. 登入試探 ----------
    //   學生登入時往這裡寫一筆 { code, at }。
    //   規則用 get() 去比對 /secret/{sid} 的驗證碼 —— 規則讀得到，學生讀不到。
    //   寫得進去＝驗證通過；寫不進去（permission-denied）＝驗證碼錯誤。
    //
    //   ⚠️ 寫入的內容含驗證碼，所以這個集合同樣**只有老師可讀**。
    match /session/{sid} {
      allow read: if isTeacher();        // ❌ 學生不可讀，否則等於換個地方外洩
      allow list: if isTeacher();
      allow delete: if isTeacher();

      //   開關關掉時直接不成立 ＝ 驗證碼登入整條路封死
      allow create, update: if legacyAllowed()
                            && isSignedIn()
                            && loginShapeOk()
                            && request.resource.data.code ==
                               get(/databases/$(database)/documents/secret/$(sid)).data.code;
    }


    // ###################################################################
    // ##  B. 115-1 上學期（11501）
    // ###################################################################

    // 課程設定（成績簿／換算／快照／上課日）
    match /11501-config/{docId} {
      allow read, write: if isTeacher();
    }

    // 統一進度／星星（hub 儀表板；闖關紀錄也在這裡的 history）
    match /11501-progress/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();          // ❌ 學生不可整批下載全班成績

      /* ★ 寫入條件（過渡期兩條路徑並存）
           ① Google 帳號本人 isOwner(sid) —— 真正做到「只有本人能寫」
           ② 舊的匿名登入 —— 認不出本人，只能靠「動作幅度」防呆
         兩條都要通過學期鎖；老師與測試帳號不受限。
         全面切換到 Google 之後，把 ② 整段刪掉，防呆條件也可以一起拿掉。 */
      allow create: if isTeacher()
                    || (isOwner(sid) && (beforeSpring() || isTestAccount(sid)))
                    || (legacyAllowed() && isSignedIn() && firstWriteIsSmall()
                        && (beforeSpring() || isTestAccount(sid)));
      allow update: if isTeacher()
                    || (isOwner(sid) && (beforeSpring() || isTestAccount(sid)))
                    || (legacyAllowed() && isSignedIn() && starsNotReduced() && gainIsSmall()
                        && (beforeSpring() || isTestAccount(sid)));

      allow delete: if isTeacher();        // ❌ 避免有人清掉別人的成績
    }

    // Scratch AI 批改：評分標準
    //   ★ 2026-07-29：Colab 後端改為匿名登入後帶 idToken，
    //     所以這裡從 `if true`（全世界可讀）收成 `if isSignedIn()`。
    match /11501-grader/{docId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // Scratch AI 批改：批改紀錄（Colab 後端新增）
    //   ★ 同上：原本 `create: if true` 等於全世界都能往這裡無限寫入，帳單算老師的。
    match /11501-scratch-submissions/{recId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isTeacher();
    }


    // ###################################################################
    // ##  C. 115-2 下學期（11502）— 與上學期規則相同，僅集合名不同
    // ###################################################################

    match /11502-config/{docId} {
      allow read, write: if isTeacher();
    }

    match /11502-progress/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();

      /* ★ 寫入條件（過渡期兩條路徑並存）—— 與上學期完全相同的邏輯
           ① Google 帳號本人 isOwner(sid)
           ② 舊的匿名登入（動作幅度防呆）
         全面切換到 Google 之後，把 ② 整段刪掉。 */
      allow create: if isTeacher()
                    || (isOwner(sid) && (afterSpring() || isTestAccount(sid)))
                    || (legacyAllowed() && isSignedIn() && firstWriteIsSmall()
                        && (afterSpring() || isTestAccount(sid)));
      allow update: if isTeacher()
                    || (isOwner(sid) && (afterSpring() || isTestAccount(sid)))
                    || (legacyAllowed() && isSignedIn() && starsNotReduced() && gainIsSmall()
                        && (afterSpring() || isTestAccount(sid)));

      allow delete: if isTeacher();
    }

    match /11502-grader/{docId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    match /11502-scratch-submissions/{recId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isTeacher();
    }


    // ###################################################################
    // ##  D. 待淘汰 —— 舊版頁面還在用，切換完成後整區刪除
    // ###################################################################

    // ---------- D1. 舊名冊：資料搬進 /roster 後刪除 ----------
    match /11501-roster/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
                    || (isSignedIn() && codeNotSet()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['code', 'updatedAt']));
    }
    match /11502-roster/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
                    || (isSignedIn() && codeNotSet()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['code', 'updatedAt']));
    }

    // ---------- D2. 舊闖關紀錄：新版引擎已改寫進 progress.history ----------
    //   舊版 cyberethics.html / social.html 與教師端還在讀，先留著。
    match /artifacts/{appId}/public/data/quiz_records/{recId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isTeacher();        // ❌ 既有紀錄不可被改寫（防止改分數）
      allow delete: if isSignedIn();       // 學生會刪掉同章節較差的舊紀錄
    }
    match /artifacts/{appId}/public/data/quiz_records_115_2/{recId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isTeacher();
      allow delete: if isSignedIn();
    }

    // ---------- D3. 運算思維與任務表的自有集合 ----------
    //   這幾支也還沒收進 {學期}-progress，之後比照 quiz_records 辦理。
    match /artifacts/{appId}/public/data/progress/{docId} {            // 11501 運算思維
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }
    match /artifacts/{appId}/public/data/progress_sem2/{docId} {       // 11502 運算思維
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }
    match /artifacts/{appId}/public/data/studentProgress_115_2/{docId} {  // 11502 任務確認表
      allow get: if isSignedIn();
      allow list: if isTeacher();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }


    // ###################################################################
    // ##  E. 其他一律拒絕
    // ###################################################################
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
