rules_version = '2';

// =====================================================================
//  Firestore 安全規則 — 專案 suyungsheng-5f948
//  涵蓋：115 學年【上學期 11501】＋【下學期 11502】
//  貼上位置：Firebase Console → Firestore Database → 規則 → 發佈
//  規則本體最後更新：2026-08-19
//  規則本體指紋：e2e9fe56　（142 行，不含註解）
//
//  ★ 怎麼確認「線上跑的是不是這一份」
//    Firebase Console 的規則第一段也看得到上面兩行。比對**指紋**就好。
//
//  ⚠️ 為什麼要用指紋，不能只看日期
//    這個檔案有三個日期，而且它們常常不一樣：
//      ‧ 檔案修改時間 / git commit ── 只要動過就會變（包含只改註解）
//      ‧ 上面那行「規則本體最後更新」── 只在規則真的改動時才更新
//    2026-08-25 就出現過這種落差：那天只補了說明文字，
//    檔案日期變成 08-25，而規則本體仍然是 08-19 的。
//    ⇒ 日期分不出「改註解」和「改規則」，指紋分得出來：
//      它只算剝掉註解之後的規則本體，寫再多說明都不會變。
//
//  ⚠️ 改了規則就要更新指紋。忘了的話 rules.test.js 會紅，
//     它每次都重算一遍跟這裡比對（算法見那支測試）。
//
//  ★ 沿革：08-19 那三筆改動忘了更新日期，於是「最後更新」停在 08-11，
//    比對起來會誤判成「線上已經是最新的」—— 和 08-06～08-11
//    那次五天沒上線是同一種安靜失敗。
// ---------------------------------------------------------------------
//  ⚠️ 一個 Firebase 專案只有「一份」規則，發佈時整份覆蓋。
//     這份就是正本，改這裡就好（2026-07 併成單一 repo 之後同步機制已移除）。
//
//  ⚠️ 這裡是全系統唯一「刻意保留重複」的地方：
//     兩學期的規則明明長得一樣，仍然分開寫。理由是安全規則寫錯的代價太高，
//     用正規式把 11501/11502 合成一條雖然短，但出事時很難一眼看出哪裡開太大。
//     其他檔案追求「一份程式」，這一份追求「一眼看得懂」。
// ---------------------------------------------------------------------
//  ★ 2026-07-29 改版重點
//    ① 名冊改為跨學期共用一份 /roster（同一批八年級學生）。
//       舊的 {學期}-roster 保留到資料遷移完成，之後可整段刪除。
//    ② 刪掉 {學期}-grades：規則裡有，但全站沒有任何一行程式讀寫它。
//    ③ 闖關紀錄（quiz_records）改存進 {學期}-progress 的 history。
//       舊集合的規則移到「待淘汰」區，舊版頁面下線後刪除。
//    ④ 學期鎖：{學期}-progress 的學生寫入限制在該學期期間（用 request.time）。
//       老師不受限；測試帳號見 isTestAccount()。
//    ⑤ 2026-07-30：加入學校 Google 帳號路徑 isOwner(sid)。
//       email 由學號直接組出（qfm{學號}@mail.qfm.kh.edu.tw），不需要對照表，
//       真正做到「只有本人能寫自己的進度」——這是匿名登入時期做不到的。
//       目前與舊的匿名路徑並存，兩條都能寫；全面切換後刪掉匿名那條。
//       老師身分改用 email 白名單（師生都是 google.com，分不出 provider）。
//    ⑥ 2026-08-03：{學期}-progress 多了 modules.list（前導教材通過紀錄）。
//       ★ 這一份規則不做欄位白名單，只看 totalStars 的增減，
//         所以新增欄位不必改規則——這裡記一筆是避免日後有人以為漏改了。
//         學生端用 merge 寫入，totalStars 不動，starsNotReduced 自然成立。
//    ⑦ 2026-08-03：驗證碼備援加上總開關 config/auth。
//       全站已改用學校 Google 帳號，驗證碼只留備援。
//       開關關掉時，舊的匿名寫入路徑、驗證碼設定、登入試探全部失效。
//       ★ 這個開關必須做在規則裡才有意義：只把前端欄位藏起來的話，
//         匿名路徑還在，任何登入者照樣寫得動別人的進度。
//    ⑪ 2026-08-19：三筆一起（都已由老師發布並確認）
//       ‧ {學期}-config/schedule 開單筆 get 給學生端 —— 本週成績卡要照
//         該班上課日判出席，讀不到課表就會把全班都算成缺席。
//       ‧ inRoster(sid) 變成**寫入條件**：不在名冊就寫不進進度。
//         前端擋的是「走錯」，規則擋的是「硬闖」。
//         ⚠️ 代價：名冊沒建好 ＝ 全班 permission-denied，
//            症狀和「規則沒發布」一模一樣。順序永遠是先建名冊、再讓學生登入。
//       ‧ 測試帳號 1410905 關閉（TEST_IDS 清空，semester.js 同步）。
//
//    ── 備註（刻意不編號、不寫日期）─────────────────────
//       5016B 智慧家居機電專題（五節）完成時確認過：**這份規則不必改**。
//       它寫的是既有的 11501-progress、讀的是既有的 /roster，沒有新集合。
//       ⚠️ 這一筆不給日期，是因為上面那行「最後更新」代表的是
//          **規則內容**的版本 —— 老師拿它跟 Console 比對。
//          只改註解卻把日期往前推，會製造一次假警報。
//
//    ⑧ 2026-08-03：Colab 後端改用服務帳戶（不受安全規則限制），
//       {學期}-grader 與 {學期}-scratch-submissions 因此收成只有老師。
//       ⚠️ 順序很重要：先設好 Colab 的 FIREBASE_SA、確認 /api/health 的
//          fs_auth_mode 是 service_account，再發布這份規則。
//          反過來的話 AI 批改會寫不進去，而關卡是依序開放的，全班會卡住。
// ---------------------------------------------------------------------
//  身分判斷方式：
//    老師 = 學校 Google 帳號 suyungsheng@mail.qfm.kh.edu.tw（白名單）
//    學生 = 學校 Google 帳號 qfm{學號}@mail.qfm.kh.edu.tw
//           （舊的匿名登入＋驗證碼只在 config/auth 開關打開時有效）
//
//    ⑩ 2026-08-11：補上 bonusEmpty() / bonusUnchanged() 的**函式本體**。
//       08-06 的改版只加了呼叫，沒寫定義 —— 規則有未定義的函式時，
//       「發布」那一步會整份編譯失敗，所以那之後這份規則一次都沒上線過。
//       線上跑的還是 08-06 以前的舊版（沒有 isTestAccount），
//       學生端看到的只有一行 permission-denied。
//       ⚠️ 這一份改完請**真的按一次發布**，看到「已發佈」再收工。
//       shared/tests/rules.test.js 現在會擋掉同樣的錯。
//
//    ⑨ 2026-08-04：匿名登入與 email/密碼登入都已在 Firebase 停用，
//       驗證碼備援整套移除（legacyAllowed／secret／session／hasCode）。
//       進度寫入現在只剩 isTeacher() 與 isOwner(sid)，
//       也就是真正的「只有本人能寫自己的」。
//
//  現行防線：
//    1. 整批撈走全班姓名 → list 只給老師
//    2. 整批撈走或刪除全班成績 → list/delete 只給老師
//    3. 寫別人的進度 → isOwner(sid) 直接擋掉（email 由學號組出來）
//    4. 跨學期寫入 → 學期鎖用伺服器時間判斷，改前端沒用
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= 共用判斷 =================
    function isSignedIn() {
      return request.auth != null;
    }
    /* ===== 學校 Google 帳號 =====
       學生：qfm{7 位學號}@mail.qfm.kh.edu.tw
       老師：suyungsheng@mail.qfm.kh.edu.tw（固定，不會更換）

       ⚠️ 師生都用 Google 登入之後，sign_in_provider 都是 'google.com'，
          沒辦法再靠登入方式分辨身分，所以老師改用 email 白名單。 */
    function TEACHER_EMAIL() { return 'suyungsheng@mail.qfm.kh.edu.tw'; }
    function DOMAIN()        { return '@mail.qfm.kh.edu.tw'; }

    function googleVerified() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string;
    }

    /** 老師 = 學校 Google 帳號白名單。
        ★ 2026-08-04：刪掉舊的 email/密碼分支。
          原本寫 `sign_in_provider == 'password'` 就算老師 ——
          等於任何一個用 email/密碼註冊的帳號都是老師，條件太寬。
          Firebase 已停用該登入方式，教師端也只剩 Google 登入。 */
    function isTeacher() {
      return googleVerified()
          && request.auth.token.email == TEACHER_EMAIL();
    }

    /** 這個 Google 帳號是不是「學號 sid 本人」。
        email 直接由學號組出來，不需要任何對照表 —— 這是這套帳號格式最大的好處。 */
    function isOwner(sid) {
      return googleVerified()
          && request.auth.token.email == 'qfm' + sid + DOMAIN();
    }

    /* 這個學號在不在名冊裡。
       ---------------------------------------------------------------
       ★ 2026-08-19 老師問：「禁止不在名單內的使用者登入是無法實現？」
         —— 做得到，但位置在**這裡**，不是前端。

         hub.html 登入時本來就會查名冊、查不到就登出，可是那是前端：
         學號存在 sessionStorage，按 F12 塞一個進去、直接開關卡頁，
         guard.js 只看「有沒有 14 開頭的 7 碼」，就進得去了。
         而規則這一層原本只問 isOwner(sid)（email 對得上學號），
         也不看名冊 —— 於是任何一個學校 Google 帳號都寫得動自己那份進度。

         ⇒ 把「名冊裡有這個人」變成寫入條件，才是真的擋住。
           前端擋的是「走錯」，規則擋的是「硬闖」。

       ★ 名冊是**跨學期共用**的 /roster/{學號}（2026-07-29 合併，
         不是 {學期}-roster —— 那兩個是等著刪的舊集合）。

       ⚠️ 代價一：exists() 是一次真正的文件讀取，每一次進度寫入都多一次
          （算進免費額度的每日讀取量）。一堂課一個班大約多幾百次，還好。
       ⚠️ 代價二：**名冊沒建好，全班就寫不進去**（permission-denied）。
          症狀和「規則沒發布」長得一模一樣，都是主控台一行紅字。
          所以開學前的順序是：先建名冊 → 再讓學生登入。
          06_上線檢查表 那一條「名冊有全班學號」從此不是建議，是硬相依。 */
    function inRoster(sid) {
      return exists(/databases/$(database)/documents/roster/$(sid));
    }

    /* ===== 學期鎖 =====
       學生只能寫「當學期」的進度。這是真正的防線 ——
       request.time 是伺服器時間，改前端、改電腦時鐘都繞不過去。
       （前端 shared/semester.js 的鎖只是先擋下畫面、給提示。）

       界線：2027-02-01 起為下學期。
         ‧ 學年開始前（準備期）算上學期 → 11501 沒有下界
         ‧ 學年結束後仍算下學期       → 11502 沒有上界
       與 shared/semester.js 的 TABLE 一致，改一邊要改另一邊。 */
    function beforeSpring() {
      return request.time < timestamp.date(2027, 2, 1);
    }
    function afterSpring() {
      return request.time >= timestamp.date(2027, 2, 1);
    }

    /* 測試帳號：不受學期鎖限制。
       ⚠️ 這份清單在 shared/semester.js 裡有一份**一模一樣**的複製
          （安全規則沒辦法載入 JS）。改一邊就要改另一邊。

       ★ CLOSED 2026-08-19：清單是空的，這是**刻意的**。
         11502 的內容驗完了（老師：「11502 測試到此為止，可以關閉測試帳號
         1410905，已由名單中移除」），線上就不該再留一個繞得過學期鎖的帳號。
         函式本身留著 —— 下面四行 allow 都還呼叫它，拆掉要動四個地方；
         要重開只要把學號填回這裡與 semester.js（兩邊一模一樣），再發布。
       ⚠️ 這一份改完請**真的按一次發布**，親眼看到「已發佈」。
          沒發布的話線上跑的還是舊版（1410905 依然寫得進 11502-progress），
          而且不會有任何錯誤訊息告訴你。 */
    function isTestAccount(sid) {
      return sid in [];                 // ← 和 shared/semester.js 的 TEST_IDS 一模一樣（目前：無）
    }

    /* ===== 已刪除：進度文件的「動作幅度」防呆 =====
       starsIn / oldStars / starsNotReduced / gainIsSmall / firstWriteIsSmall
       是匿名登入時代的替代品 —— 規則認不出本人，只好限制「星星不能變少、
       一次不能加太多」。2026-08-04 全面改用學校 Google 帳號之後，
       isOwner(sid) 已經做到「只有本人能寫自己的」，這些近似條件沒有必要，
       留著只會讓人誤以為還有第二道防線。 */

    /* ===== 老師給的加分星：學生寫不動 =====
       modules.flowchart.imgUnits（交流程圖圖片 +1★）
       modules.scratch.vidUnits  （交程式錄影   +1★）
       這兩格由 shared/review.html 以老師身分寫入，內容是 { 關卡: { at, by } }。

       ★ 為什麼一定要寫在規則裡
         學生本來就有權寫「自己的整份進度文件」（他每通一關就 merge 一次）。
         不擋的話，按 F12 就能把 imgUnits 塞滿十關 ——
         白送 10 顆「老師確認過」的星，而且比自動算出來的更難事後分辨。
         前端把按鈕藏起來完全沒有用。

       ⚠️ 2026-08-11：這兩支在 2026-08-06 就被 allow 條件呼叫了，
          但**函式本體從來沒寫**。Firestore 規則有未定義的函式會在
          「發布」那一步整份編譯失敗 —— 也就是說那天之後這份規則
          一次都沒有真的上線過，線上跑的還是 08-06 以前的舊版
          （沒有 isTestAccount，所以連測試帳號都寫不進 11502）。
          症狀只有一行 permission-denied，看起來像網路問題。
          `rules.test.js` 現在會檢查「呼叫到的函式都有定義」。

       ★ 用 get(欄位, 預設值) 串起來讀，不用 request.resource.data.modules.…：
         學生端是 merge 寫入，沒帶到的那幾層在 request.resource.data 裡
         **確實存在**（合併後的完整文件），但第一次建立時整棵都不在，
         直接點下去會噴錯誤而不是判 false。 */
    function imgUnitsOf(d) {
      return d.get('modules', {}).get('flowchart', {}).get('imgUnits', {});
    }
    function vidUnitsOf(d) {
      return d.get('modules', {}).get('scratch', {}).get('vidUnits', {});
    }
    /** 建立文件時：不可以夾帶加分（新生的第一筆本來就不該有） */
    function bonusEmpty() {
      return imgUnitsOf(request.resource.data).size() == 0
          && vidUnitsOf(request.resource.data).size() == 0;
    }
    /** 更新文件時：加分那兩格前後必須一模一樣（不能加、不能改、不能刪） */
    function bonusUnchanged() {
      return imgUnitsOf(request.resource.data) == imgUnitsOf(resource.data)
          && vidUnitsOf(request.resource.data) == vidUnitsOf(resource.data);
    }

    // ###################################################################
    // ##  A. 跨學期共用
    // ###################################################################

    // ---------- A1. 學生名冊（姓名／班級／座號，★不含驗證碼）----------
    //   上下學期是同一批八年級學生，名冊只需要一份。
    //   這裡存的是「人」；成績與進度仍然分學期。
    //   ⚠️ 驗證碼**不放在這裡**，只留一個 hasCode 旗標讓登入頁判斷是否首次登入。
    match /roster/{sid} {
      // 單筆查詢：登入流程需要（讀姓名讓學生確認身分）
      allow get: if isSignedIn();
      // ❌ 禁止整批下載：避免一次撈走全班姓名
      allow list: if isTeacher();

      allow create, delete: if isTeacher();

      // 名冊只有老師能改。
      //   ★ 2026-08-04：原本開放學生在「尚未設定驗證碼」時寫 hasCode，
      //     驗證碼整套移除後不再需要。
      allow update: if isTeacher();
    }


    // ---------- A1b. 全站開關（★ 學生「讀得到」）----------
    //   目前只有一份 config/auth：{ allowLegacy: bool }
    //   學生端要讀它才知道登入畫面該不該顯示驗證碼欄位，
    //   （驗證碼備援移除後，規則本身已不再讀它；保留集合是為了未來的全站開關。）
    //
    //   ⚠️ 學生讀得到 ＝ 這個集合只能放「公開也無所謂」的設定。
    //      任何密碼、名單、答案都不可以放這裡；
    //      課程設定請放 {學期}-config（那個是老師才讀得到的）。
    //
    //   ★ read 是 `if true`，不是 `if isSignedIn()`：
    //     闖關基地要在「還沒登入」的狀態下讀它，才知道登入畫面該不該
    //     顯示驗證碼欄位。寫成 isSignedIn() 會變成雞生蛋 ——
    //     沒登入讀不到 → 一律當關閉 → 驗證碼備援永遠打不開，
    //     而那正是 Google 掛掉時唯一的退路。
    //     內容只有一個布林值，公開讀沒有任何損失。
    match /config/{docId} {
      allow read:  if true;
      allow write: if isTeacher();
    }


    // ###################################################################
    // ##  B. 115-1 上學期（11501）
    // ###################################################################

    // 課程設定（成績簿／換算／快照／上課日）
    match /11501-config/{docId} {
      allow read, write: if isTeacher();
      /* ★ 2026-08-19：課表要開一個小口給學生端。
         老師定的規則是「這週有登入但沒拿星 → 60 分，缺席 → 0 分」，
         而「出席」是照**該班上課日**判定的 —— 學生端的本週成績卡
         得自己算一次，就必須讀得到課表。
         ⚠️ 只開 schedule 這一份、只開單筆 get（不給 list）——
            其他 config（gradebook、snapshots）維持只有老師。
         ⚠️ 沒發布這份規則的話，學生端拿到 permission-denied，
            症狀是「本週成績卡永遠當成缺席」，不會有錯誤訊息。 */
      allow get: if docId == 'schedule' && isSignedIn();
    }

    /* 後端記的「這個學號過了哪幾關」（運算思維截圖判定）
       ══════════════════════════════════════════════════════
       ⚠️⚠️ 2026-09-03：星星是**學生的瀏覽器**寫進 {學期}-progress 的。
          改成「上傳完就能關掉」之後，學生傳完就走 ——
          後端明明已經評完、也記在這裡了，老師端卻完全看不到，
          要等那個學生下次登入才會同步。
       ⇒ 開給老師讀，教師端就能用 shared/grading.js 當場換算星星。
       ★ 只給讀、只給老師：這份是後端用**服務帳戶**寫的
         （服務帳戶不受規則限制），所以這裡完全不需要開放寫入。
       ⚠️ 學生也不給讀 —— 他們要的是自己那一份，走後端的
          /api/my-passed（那支只回自己的），不必開放整個集合。
       ⚠️⚠️ 這份規則**沒有發布**的話，教師端會拿到 permission-denied。
          那邊已經包了 try/catch，畫面不會壞，只是看不到未同步的部分 ——
          症狀是「明明有學生通關了，老師端卻沒有」。 */
    match /11501-ocr-passed/{sid} {
      allow read: if isTeacher();
    }
    /* 借圖偵測：截圖的 sha256 -> 用過這張圖的學號們。
       ⚠️ 後端用服務帳戶寫（不受規則限制），這裡只要開給老師讀。
       ⚠️ 學生不給讀 —— 那等於公布誰跟誰用了同一張圖。 */
    match /11501-shot-hashes/{h} {
      allow read: if isTeacher();
    }
    match /11502-shot-hashes/{h} {
      allow read: if isTeacher();
    }
    match /11502-ocr-passed/{sid} {
      allow read: if isTeacher();
    }

    // 統一進度／星星（hub 儀表板；闖關紀錄也在這裡的 history）
    match /11501-progress/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();          // ❌ 學生不可整批下載全班成績

      /* ★ 寫入條件（過渡期兩條路徑並存）
           ① Google 帳號本人 isOwner(sid) —— 真正做到「只有本人能寫」
           ② 舊的匿名登入 —— 認不出本人，只能靠「動作幅度」防呆
         兩條都要通過學期鎖；老師與測試帳號不受限。
         全面切換到 Google 之後，把 ② 整段刪掉，防呆條件也可以一起拿掉。 */
      allow create: if isTeacher()
                    || (isOwner(sid) && inRoster(sid) && bonusEmpty()
                        && (beforeSpring() || isTestAccount(sid)));
      allow update: if isTeacher()
                    || (isOwner(sid) && inRoster(sid) && bonusUnchanged()
                        && (beforeSpring() || isTestAccount(sid)));

      allow delete: if isTeacher();        // ❌ 避免有人清掉別人的成績
    }

    // Scratch AI 批改：評分標準
    //   ★ 2026-08-03：Colab 後端改用服務帳戶，服務帳戶**不受安全規則限制**，
    //     所以不必再為後端留 isSignedIn() 的縫，直接收成只有老師。
    //     （前端完全不碰這個集合：教師端是透過後端的 /api/teacher/config 存取。）
    //   ⚠️ 這條規則等於「後端必須用服務帳戶」。發布前請先確認
    //      /api/health 的 fs_auth_mode 是 service_account，否則批改會寫不進去。
    match /11501-grader/{docId} {
      allow read, write: if isTeacher();
    }

    // Scratch AI 批改：批改紀錄（Colab 後端新增）
    //   ★ 2026-08-03：改用服務帳戶後 create 也收成只有老師
    //     （寫入的是後端，它不受規則限制；學生端從來沒碰過這個集合）。
    match /11501-scratch-submissions/{recId} {
      allow create, read, update, delete: if isTeacher();
    }


    // ###################################################################
    // ##  C. 115-2 下學期（11502）— 與上學期規則相同，僅集合名不同
    // ###################################################################

    match /11502-config/{docId} {
      allow read, write: if isTeacher();
      /* ★ 2026-08-19：課表要開一個小口給學生端。
         老師定的規則是「這週有登入但沒拿星 → 60 分，缺席 → 0 分」，
         而「出席」是照**該班上課日**判定的 —— 學生端的本週成績卡
         得自己算一次，就必須讀得到課表。
         ⚠️ 只開 schedule 這一份、只開單筆 get（不給 list）——
            其他 config（gradebook、snapshots）維持只有老師。
         ⚠️ 沒發布這份規則的話，學生端拿到 permission-denied，
            症狀是「本週成績卡永遠當成缺席」，不會有錯誤訊息。 */
      allow get: if docId == 'schedule' && isSignedIn();
    }

    match /11502-progress/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();

      /* ★ 寫入條件（過渡期兩條路徑並存）—— 與上學期完全相同的邏輯
           ① Google 帳號本人 isOwner(sid)
           ② 舊的匿名登入（動作幅度防呆）
         全面切換到 Google 之後，把 ② 整段刪掉。 */
      allow create: if isTeacher()
                    || (isOwner(sid) && inRoster(sid) && bonusEmpty()
                        && (afterSpring() || isTestAccount(sid)));
      allow update: if isTeacher()
                    || (isOwner(sid) && inRoster(sid) && bonusUnchanged()
                        && (afterSpring() || isTestAccount(sid)));

      allow delete: if isTeacher();
    }

    // Scratch AI 批改：評分標準
    //   ★ 2026-08-03：Colab 後端改用服務帳戶，服務帳戶**不受安全規則限制**，
    //     所以不必再為後端留 isSignedIn() 的縫，直接收成只有老師。
    //     （前端完全不碰這個集合：教師端是透過後端的 /api/teacher/config 存取。）
    //   ⚠️ 這條規則等於「後端必須用服務帳戶」。發布前請先確認
    //      /api/health 的 fs_auth_mode 是 service_account，否則批改會寫不進去。
    match /11502-grader/{docId} {
      allow read, write: if isTeacher();
    }

    // Scratch AI 批改：批改紀錄（Colab 後端新增）
    //   ★ 2026-08-03：改用服務帳戶後 create 也收成只有老師
    //     （寫入的是後端，它不受規則限制；學生端從來沒碰過這個集合）。
    match /11502-scratch-submissions/{recId} {
      allow create, read, update, delete: if isTeacher();
    }


    // ###################################################################
    // ##  D. 待淘汰 —— 舊版頁面還在用，切換完成後整區刪除
    // ###################################################################

    // ---------- D1. 舊名冊：資料搬進 /roster 後刪除 ----------
    match /11501-roster/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();
      // ★ 2026-08-04：驗證碼整套移除，學生不再需要寫舊名冊，全部收成只有老師。
      allow create, update, delete: if isTeacher();
    }
    match /11502-roster/{sid} {
      allow get: if isSignedIn();
      allow list: if isTeacher();
      // ★ 2026-08-04：驗證碼整套移除，學生不再需要寫舊名冊，全部收成只有老師。
      allow create, update, delete: if isTeacher();
    }

    // ---------- D2. 舊闖關紀錄：新版引擎已改寫進 progress.history ----------
    //   舊版 cyberethics.html / social.html 與教師端還在讀，先留著。
    match /artifacts/{appId}/public/data/quiz_records/{recId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isTeacher();        // ❌ 既有紀錄不可被改寫（防止改分數）
      allow delete: if isSignedIn();       // 學生會刪掉同章節較差的舊紀錄
    }
    match /artifacts/{appId}/public/data/quiz_records_115_2/{recId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isTeacher();
      allow delete: if isSignedIn();
    }

    // ---------- D3. 運算思維與任務表的自有集合 ----------
    //   這幾支也還沒收進 {學期}-progress，之後比照 quiz_records 辦理。
    match /artifacts/{appId}/public/data/progress/{docId} {            // 11501 運算思維
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }
    match /artifacts/{appId}/public/data/progress_sem2/{docId} {       // 11502 運算思維
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }
    match /artifacts/{appId}/public/data/studentProgress_115_2/{docId} {  // 11502 任務確認表
      allow get: if isSignedIn();
      allow list: if isTeacher();
      allow create, update: if isSignedIn();
      allow delete: if isTeacher();
    }


    // ###################################################################
    // ##  E. 其他一律拒絕
    // ###################################################################
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
