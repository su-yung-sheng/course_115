#!/bin/sh
# =====================================================================
#  提交前自動檢查（GitHub Desktop 按 Commit 也會觸發）
# ---------------------------------------------------------------------
#  這支不是放在 repo 裡就會生效的檔案。
#  git hooks 住在 .git/hooks/，而 .git/ 不會被版控，
#  所以重新 clone 之後要再跑一次「安裝檢查掛鉤.bat」。
#
#  它會跑 shared/check.py：
#    空檔、HTML 壞掉、JS 語法、死連結、名冊設定不一致、.bat 換行錯誤…
#  想跳過（很少需要，例如只改 README）：
#    git commit --no-verify
#  但 GitHub Desktop 沒有這個選項，真的要跳過就用命令列。
# =====================================================================

echo ""
echo "── 提交前檢查 ─────────────────────────────"

# 找 Python：Git Bash 底下 py 不一定有，優先試 python
PY=""
command -v python  >/dev/null 2>&1 && PY=python
[ -z "$PY" ] && command -v python3 >/dev/null 2>&1 && PY=python3
[ -z "$PY" ] && command -v py      >/dev/null 2>&1 && PY=py

if [ -z "$PY" ]; then
  echo "⚠️  找不到 Python，略過檢查（建議安裝後再提交）"
  exit 0
fi

if [ -f "shared/check.py" ]; then
  OUT=$("$PY" shared/check.py 2>&1)
  RC=$?
  echo "$OUT"
  if [ $RC -ne 0 ]; then
    echo ""
    # 「檢查程式自己壞了」和「檢查有發現問題」要分得出來。
    # 2026-08-06 就踩過：check.py 印中文時在 cp950 主控台崩潰，
    # hook 只看到非 0 就說「檢查沒過」，於是提交被取消、檔案留在 staged，
    # 使用者看到的是「按 Commit 沒反應、也推不上去」，完全找不到方向。
    case "$OUT" in
      *Traceback*|*UnicodeEncodeError*)
        echo "⚠️  檢查程式本身出錯了（不是你的檔案有問題），這次提交已取消。"
        echo "   請在命令列執行：$PY shared/check.py   看完整錯誤訊息。"
        echo "   真的急著提交可以用：git commit --no-verify"
        ;;
      *)
        echo "❌ 檢查沒過，這次提交已取消。"
        echo "   修好上面列出的問題再按一次 Commit。"
        ;;
    esac
    exit 1
  fi
else
  echo "⚠️  找不到 shared/check.py，略過完整性檢查"
fi

# ── 測試 ───────────────────────────────────────────
# ⚠️ 2026-08-07 加的。原本這個 hook 只跑 check.py，
#    於是「測試紅燈」完全擋不住 —— 那天就這樣提交了一次帶著兩個
#    失敗測試的變更，而且是自己過幾分鐘才發現。
#    check.py 看的是「檔案有沒有一致」，測試看的是「行為對不對」，
#    兩件事都會壞，只擋一種等於只有一半的保護。
#
# ★ 缺套件不算失敗
#   blocks.test.js 需要 jsdom；沒裝的時候它會印一行提示並回非 0。
#   那是「這台機器沒裝」，不是「程式壞了」——
#   因為缺套件就擋住提交，只會讓人養成 --no-verify 的習慣，
#   那比沒有 hook 更糟。
if command -v node >/dev/null 2>&1; then
  echo ""
  echo "── 跑測試 ─────────────────────────────────"
  FAILED=""
  SKIPPED=""
  for f in shared/tests/*.test.js; do
    [ -f "$f" ] || continue
    OUT=$(node "$f" 2>&1)
    if [ $? -ne 0 ]; then
      case "$OUT" in
        *"npm install"*|*"Cannot find module"*) SKIPPED="$SKIPPED $(basename "$f")" ;;
        *) FAILED="$FAILED $(basename "$f")"
           echo ""
           echo "❌ $(basename "$f")"
           echo "$OUT" | grep -E "❌|✗|失敗" | head -8 ;;
      esac
    fi
  done

  [ -n "$SKIPPED" ] && echo "（略過：$SKIPPED —— 缺套件，不是失敗）"

  if [ -n "$FAILED" ]; then
    echo ""
    echo "❌ 測試沒過，這次提交已取消：$FAILED"
    echo "   單獨重跑看完整訊息，例如：node shared/tests/$(echo $FAILED | awk '{print $1}')"
    echo "   真的急著提交可以用：git commit --no-verify"
    exit 1
  fi
  echo "✅ 測試全過"
else
  echo "⚠️  找不到 node，略過測試"
fi

echo ""
echo "── 檢查通過，繼續提交 ─────────────────────"
echo ""
exit 0
